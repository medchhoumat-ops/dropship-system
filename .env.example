# Copy to .env and fill in. NEVER commit .env.
# Any key left empty puts that client in mock mode (sample fixtures).

# CJ Dropshipping API access token (sent as the CJ-Access-Token header).
# Get it in CJ > Developer > API Key, then authentication/getAccessToken.
CJ_MCP_TOKEN=

# AliExpress Open Platform (Drop Shipping API) – https://openservice.aliexpress.com
AE_APP_KEY=
AE_APP_SECRET=
AE_ACCESS_TOKEN=

# Apify (Amazon scraper actor) – https://console.apify.com/account/integrations
APIFY_TOKEN=
# Optional: override the Amazon actor (default junglee~amazon-crawler)
APIFY_AMAZON_ACTOR=

# Semrush API key (Business plan API units) – keyword volume + 12-month trend
SEMRUSH_API_KEY=

# SerpApi – Google Shopping + (optional) Google Trends
SERPAPI_KEY=

# Runtime switches
# DROPSHIP_MOCK=1          # force mock mode for every client
# DROPSHIP_DATA_DIR=./data # where cache/ and runs/ live
# DROPSHIP_CONFIG=./config/settings.toml
