<section class="section{% if section.settings.alt %} section--alt{% endif %}">
  <div class="container">
    <header class="section__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </header>
    <div class="grid grid--{{ section.settings.columns }}">
      {%- assign source = section.settings.collection.products | default: collections.all.products -%}
      {%- for product in source limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..3) -%}<article class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div><div class="card__body"><h3 class="card__title">{{ 'general.product_placeholder' | t }}</h3></div></article>{%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collection en avant",
  "class": "section-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La sélection" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Matin & soir" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Colonnes", "default": "4", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "checkbox", "id": "alt", "label": "Fond alterné", "default": false }
  ],
  "presets": [{ "name": "Collection en avant" }]
}
{% endschema %}
