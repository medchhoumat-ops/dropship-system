<section class="section">
  <div class="container container--narrow">
    <h1 class="section__title">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
    {%- form 'contact', class: 'contact' -%}
      {%- if form.posted_successfully? -%}
        <p class="newsletter__ok" role="status">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}<div role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label>{{ 'contact.name' | t }}<input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
      <label>{{ 'contact.email' | t }} *<input type="email" name="contact[email]" required autocomplete="email" value="{{ form.email }}"></label>
      <label>{{ 'contact.order' | t }}<input type="text" name="contact[order]"></label>
      <label>{{ 'contact.message' | t }} *<textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea></label>
      <button class="btn btn--primary" type="submit">{{ 'contact.send' | t }}</button>
      <small>{{ 'contact.delay' | t }}</small>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Formulaire de contact", "class": "section-contact" }
{% endschema %}
