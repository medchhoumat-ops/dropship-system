<section class="password">
  <div class="container container--narrow password__inner">
    <div class="password__logo"><span class="logo" style="width: var(--logo-width)">{% render 'logo' %}</span></div>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="section__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- else -%}
      <p class="password__message">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.email' | t }}</label>
      <input id="PasswordNewsletter" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
      <button class="btn btn--primary" type="submit">{{ 'password.notify' | t }}</button>
      {%- if form.posted_successfully? -%}<p class="newsletter__ok" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="newsletter__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
    {%- endform -%}
    <small>{{ 'newsletter.legal' | t }}</small>

    <details class="password__owner">
      <summary>{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter__form' -%}
        <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
        <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}" required>
        <button class="btn btn--ghost" type="submit">{{ 'password.enter' | t }}</button>
        {%- if form.errors -%}<p class="newsletter__err" role="alert">{{ 'password.wrong' | t }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{
  "name": "Page mot de passe",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Bientôt" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Des matins plus doux arrivent." },
    { "type": "text", "id": "text", "label": "Texte (si aucun message n'est défini dans les préférences)", "default": "La boutique Lumaube ouvre très bientôt. Laissez votre e-mail pour être prévenu(e) de l'ouverture." }
  ]
}
{% endschema %}
