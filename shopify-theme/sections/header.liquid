<header class="header" data-header>
  <div class="container header__inner">
    <button class="header__burger" type="button" aria-controls="MobileNav" aria-expanded="false" data-nav-toggle>
      {% render 'icon', name: 'menu' %}<span class="visually-hidden">{{ 'header.menu' | t }}</span>
    </button>

    <a class="header__logo logo" href="{{ routes.root_url }}" style="width: var(--logo-width)">
      {% render 'logo' %}
    </a>

    <nav class="header__nav" id="MobileNav" aria-label="{{ 'header.menu' | t }}">
      <ul class="nav">
        {%- for link in section.settings.menu.links -%}
          <li><a class="nav__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__icons">
      <a class="header__icon" href="{{ routes.search_url }}">{% render 'icon', name: 'search' %}<span class="visually-hidden">{{ 'header.search' | t }}</span></a>
      <a class="header__icon header__cart" href="{{ routes.cart_url }}">
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">{{ 'header.cart' | t }}</span>
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
