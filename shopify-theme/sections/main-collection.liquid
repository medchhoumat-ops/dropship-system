<section class="section">
  <div class="container">
    <header class="section__head">
      <h1 class="section__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte section__intro">{{ collection.description }}</div>{%- endif -%}
    </header>
    {%- paginate collection.products by section.settings.per_page -%}
      <div class="grid grid--{{ section.settings.columns }}">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p>{{ 'collections.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Produits par page", "min": 4, "max": 24, "step": 4, "default": 12 },
    { "type": "select", "id": "columns", "label": "Colonnes", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] }
  ]
}
{% endschema %}
