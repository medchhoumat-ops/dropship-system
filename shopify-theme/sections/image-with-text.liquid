<section class="section{% if section.settings.alt %} section--alt{% endif %}">
  <div class="container split{% if section.settings.reverse %} split--reverse{% endif %}">
    <div class="split__media">
      {%- if section.settings.image != blank -%}
        {%- assign img_alt = section.settings.image.alt | default: section.settings.heading -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: img_alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="split__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}<a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image et texte",
  "class": "section-split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Rituel du soir" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le soir aussi, on ralentit" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Mode crépuscule, lumière tamisée et sons doux : la chambre redevient un endroit calme.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien" },
    { "type": "checkbox", "id": "reverse", "label": "Image à droite", "default": false },
    { "type": "checkbox", "id": "alt", "label": "Fond alterné", "default": false }
  ],
  "presets": [{ "name": "Image et texte" }]
}
{% endschema %}
