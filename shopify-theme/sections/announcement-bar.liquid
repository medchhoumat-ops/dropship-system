{%- if section.blocks.size > 0 -%}
<div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
  <div class="announcement__track">
    {%- for block in section.blocks -%}
      <p class="announcement__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Bandeau d'annonce",
  "class": "section-announcement",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte · Satisfait ou remboursé 30 jours" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Bandeau d'annonce", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
