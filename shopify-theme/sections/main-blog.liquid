<section class="section">
  <div class="container">
    <h1 class="section__title">{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      <div class="grid grid--3">
        {%- for article in blog.articles -%}
          <article class="card">
            {%- if article.image -%}<a class="card__media" href="{{ article.url }}">{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}</a>{%- endif -%}
            <div class="card__body">
              <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="card__tagline">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog", "class": "section-main-blog" }
{% endschema %}
