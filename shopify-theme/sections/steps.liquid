<section class="section{% if section.settings.alt %} section--alt{% endif %}">
  <div class="container">
    <header class="section__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </header>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <span class="step__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "Étapes",
  "class": "section-steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Comment ça marche" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un lever de soleil, chaque matin" },
    { "type": "checkbox", "id": "alt", "label": "Fond alterné", "default": false }
  ],
  "max_blocks": 4,
  "blocks": [
    { "type": "step", "name": "Étape", "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "default": "clock", "options": [
        { "value": "clock", "label": "Horloge" }, { "value": "sun", "label": "Soleil" }, { "value": "sound", "label": "Son" }, { "value": "moon", "label": "Lune" }, { "value": "leaf", "label": "Feuille" } ] },
      { "type": "text", "id": "title", "label": "Titre", "default": "Réglez l'heure" },
      { "type": "textarea", "id": "text", "label": "Texte", "default": "Choisissez l'heure du réveil et la durée de l'aube." } ] }
  ],
  "presets": [{ "name": "Étapes", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
