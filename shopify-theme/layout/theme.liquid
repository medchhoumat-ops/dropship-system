<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.tagged_with' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- liquid
      assign heading_font = settings.font_heading
      assign body_font = settings.font_body
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
    -%}
    {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    <style>
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}

      :root {
        --c-bg: {{ settings.color_bg }};
        --c-surface: {{ settings.color_surface }};
        --c-text: {{ settings.color_text }};
        --c-text-soft: {{ settings.color_text_soft }};
        --c-accent: {{ settings.color_accent }};
        --c-accent-2: {{ settings.color_accent_2 }};
        --c-dark: {{ settings.color_dark }};
        --f-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --f-heading-weight: {{ heading_font.weight }};
        --f-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --f-body-weight: {{ body_font.weight }};
        --f-body-bold: {{ body_font_bold.weight | default: 700 }};
        --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --logo-width: {{ settings.logo_width }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div class="toast" id="CartToast" role="status" aria-live="polite" hidden>
      <span class="toast__text">{{ 'cart.added' | t }}</span>
      <a class="toast__link" href="{{ routes.cart_url }}">{{ 'cart.view' | t }}</a>
    </div>

    <script>
      window.theme = {
        routes: { cartAdd: "{{ routes.cart_add_url }}", cart: "{{ routes.cart_url }}", cartJs: "{{ routes.cart_url }}.js" },
        delivery: { dispatchMax: {{ settings.dispatch_days_max }}, min: {{ settings.delivery_days_min }}, max: {{ settings.delivery_days_max }} },
        locale: "{{ request.locale.iso_code }}"
      };
    </script>
  </body>
</html>
