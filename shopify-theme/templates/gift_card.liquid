{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="section center">
    <div class="container container--narrow">
      <h1 class="section__title">{{ 'gift_card.title' | t }}</h1>
      <p class="price__current">{{ gift_card.balance | money }}</p>
      <p><code>{{ gift_card.code | format_code }}</code></p>
      {%- if gift_card.expired -%}<p>{{ 'gift_card.expired' | t }}</p>{%- endif -%}
      <p><a class="btn btn--primary" href="{{ shop.url }}">{{ 'cart.continue' | t }}</a></p>
    </div>
  </main>
</body>
</html>
